# ---------------------------------------------------------------------------
# Database (Supabase or Neon — both are Postgres, either works unchanged)
#
# DATABASE_URL: the pooled connection — used by the running app (Vercel
# serverless functions open lots of short-lived connections, so this must
# go through a pooler, not straight to Postgres).
#   Supabase: Project Settings -> Database -> Connection string -> "Transaction"
#             pooler (port 6543). Keep `?pgbouncer=true` in the URL — it tells
#             Prisma to skip prepared statements, which the transaction
#             pooler doesn't support.
#   Neon:     Dashboard -> Connection Details -> "Pooled connection".
#
# DIRECT_URL: an unpooled connection — used only for running migrations
# (`prisma migrate dev` / `deploy`), which need session-level features the
# transaction pooler doesn't provide.
#   Supabase: same page -> "Direct connection" (port 5432, host starts with
#             `db.`, not the `pooler.supabase.com` host).
#   Neon:     same page -> "Direct connection" (Neon's pooled and direct URLs
#             both work for migrations, but direct is the safe default).
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@pooler-host:6543/dbname?pgbouncer=true&sslmode=require"
DIRECT_URL="postgresql://user:password@direct-host:5432/dbname?sslmode=require"

# ---------------------------------------------------------------------------
# Google OAuth (Google Cloud Console -> APIs & Services -> Credentials
# -> Create OAuth client ID -> Web application)
# Authorized redirect URI: <your-deployed-url>/api/auth/callback/google
# and http://localhost:3000/api/auth/callback/google for local dev
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ---------------------------------------------------------------------------
# Auth.js — random secret used to sign session/JWT cookies.
# Generate one with: npx auth secret   (or: openssl rand -base64 33)
# ---------------------------------------------------------------------------
AUTH_SECRET="replace-with-a-random-32+-char-secret"

# Optional: restrict sign-in to one email domain (leave blank to allow any Google account)
ALLOWED_EMAIL_DOMAIN=""

# Comma-separated list of emails allowed into /admin
ADMIN_EMAILS="you@example.com"

# ---------------------------------------------------------------------------
# ZeptoMail — sends the "your vote is in" confirmation email
# ---------------------------------------------------------------------------
ZEPTO_API_KEY="Zoho-enczapikey your-zepto-mail-api-key"
# Must be an address on a domain verified in your ZeptoMail account
EMAIL_FROM="Silver Screen Club <polls@your-verified-domain.com>"

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// --- Auth.js required models (Google OAuth, database sessions) ---

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?

  accounts        Account[]
  sessions        Session[]
  votes           Vote[]
  recommendations Recommendation[]
  applications    Application[]

  createdAt DateTime @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- App models ---

enum PollStatus {
  DRAFT
  LIVE
  CLOSED
  ARCHIVED
}

model Poll {
  id        String     @id @default(cuid())
  title     String
  status    PollStatus @default(DRAFT)
  isOpen    Boolean    @default(true)
  closesAt  DateTime?
  order     Int        @default(0)
  createdAt DateTime   @default(now())

  movies Movie[]
  votes  Vote[]

  // Only one poll should ever be LIVE at a time — enforced in app code
  // (poll.ts) via a transaction, not by the schema.
}

model Movie {
  id        String   @id @default(cuid())
  pollId    String
  name      String
  meta      String
  tagline   String
  posterUrl String   @db.Text
  order     Int      @default(0)
  createdAt DateTime @default(now())

  poll  Poll   @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes Vote[]
}

// One row per (user, poll) pair, enforced by the unique constraint below —
// this is what physically guarantees "one vote per email per poll".
model Vote {
  id        String   @id @default(cuid())
  userId    String
  pollId    String
  movieId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  poll  Poll  @relation(fields: [pollId], references: [id], onDelete: Cascade)
  movie Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@unique([userId, pollId])
}

// Tracks how many emails each provider has sent on a given UTC day, so the
// confirmation-email sender can fail over Resend -> Brevo -> ZeptoMail once
// each provider's daily free-tier quota is used up. See lib/email.ts.
model EmailProviderUsage {
  id       String @id @default(cuid())
  provider String
  day      String // UTC date as "YYYY-MM-DD"
  count    Int    @default(0)

  @@unique([provider, day])
}

// Free-text "what should we screen next" suggestions, separate from Movie/Poll.
model Recommendation {
  id        String   @id @default(cuid())
  userId    String
  movieName String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// One row per confirmation-email attempt (vote or recommendation), regardless
// of which provider handled it or whether it succeeded — powers the admin
// "Email Delivery Logs" dashboard.
model EmailLog {
  id        String   @id @default(cuid())
  to        String
  subject   String
  provider  String // "resend" | "brevo" | "zeptomail" | "failed"
  status    String // "success" | "error"
  errorMsg  String?
  createdAt DateTime @default(now())
}

// --- Crew inductions ---

// A single induction drive (e.g. "Crew Inductions 2026"). Applications are
// always scoped to one cycle, so next semester's drive starts clean without
// touching this one's data. Only one cycle should be open at a time —
// enforced in app code (lib/inductions/cycle.ts), not by the schema.
model InductionCycle {
  id        String    @id @default(cuid())
  title     String
  // The public form only accepts submissions while isOpen is true AND
  // closesAt (if set) is in the future.
  isOpen    Boolean   @default(false)
  closesAt  DateTime?
  createdAt DateTime  @default(now())

  applications Application[]
  questions    InductionQuestion[]
}

// The question bank, scoped to a cycle so each drive can ask its own thing.
// Editable from /admin/inductions — a new cycle copies the previous cycle's
// questions (or the code defaults, for the very first one) so it is never
// born empty.
//
// Answers on Application are stored denormalised against a snapshot of the
// prompt, so rewording a question here never rewrites what past applicants
// were actually asked.
model InductionQuestion {
  id      String @id @default(cuid())
  cycleId String

  prompt   String  @db.Text
  hint     String? @db.Text
  // "short" | "long" | "choice" | "multi" — kept as a string rather than an
  // enum so adding a type later doesn't need a migration on this column.
  type     String
  options  String[]
  required Boolean @default(true)
  maxLength Int?
  // Empty means everyone answers it; otherwise only applicants who picked one
  // of these vertical ids see it.
  onlyFor  String[]
  order    Int      @default(0)

  cycle InductionCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  @@index([cycleId, order])
}

enum ApplicationStatus {
  SUBMITTED
  SHORTLISTED
  WAITLISTED
  REJECTED
  ACCEPTED
}

// One row per applicant per cycle. Both unique constraints matter: userId
// stops the same Google account applying twice, bitsId stops one person
// applying twice from two Google accounts.
model Application {
  id      String @id @default(cuid())
  cycleId String
  userId  String

  fullName    String
  phone       String
  bitsEmail   String
  bitsId      String
  yearOfStudy String
  // Club verticals the applicant is applying to, most-preferred first.
  verticals   String[]

  // Snapshot of the answered question bank: [{ id, section, prompt, type, answer }].
  // Stored denormalised on purpose — questions can be reworded between cycles
  // without rewriting what past applicants were actually asked.
  answers Json

  status     ApplicationStatus @default(SUBMITTED)
  reviewNote String?
  reviewedBy String?
  reviewedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cycle InductionCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([cycleId, userId])
  @@unique([cycleId, bitsId])
  @@index([cycleId, status])
}

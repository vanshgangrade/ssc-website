generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// --- Auth.js required models (Google OAuth, database sessions) ---

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?

  accounts Account[]
  sessions Session[]
  votes    Vote[]

  createdAt DateTime @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- App models ---

enum PollStatus {
  DRAFT
  LIVE
  CLOSED
  ARCHIVED
}

model Poll {
  id        String     @id @default(cuid())
  title     String
  status    PollStatus @default(DRAFT)
  isOpen    Boolean    @default(true)
  closesAt  DateTime?
  order     Int        @default(0)
  createdAt DateTime   @default(now())

  movies Movie[]
  votes  Vote[]

  // Only one poll should ever be LIVE at a time — enforced in app code
  // (poll.ts) via a transaction, not by the schema.
}

model Movie {
  id        String   @id @default(cuid())
  pollId    String
  name      String
  meta      String
  tagline   String
  posterUrl String   @db.Text
  order     Int      @default(0)
  createdAt DateTime @default(now())

  poll  Poll   @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes Vote[]
}

// One row per (user, poll) pair, enforced by the unique constraint below —
// this is what physically guarantees "one vote per email per poll".
model Vote {
  id        String   @id @default(cuid())
  userId    String
  pollId    String
  movieId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  poll  Poll  @relation(fields: [pollId], references: [id], onDelete: Cascade)
  movie Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@unique([userId, pollId])
}

// Tracks how many emails each provider has sent on a given UTC day, so the
// confirmation-email sender can fail over Brevo -> Resend -> ZeptoMail once
// each provider's daily free-tier quota is used up. See lib/email.ts.
model EmailProviderUsage {
  id       String @id @default(cuid())
  provider String
  day      String // UTC date as "YYYY-MM-DD"
  count    Int    @default(0)

  @@unique([provider, day])
}
